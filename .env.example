# Salin file ini menjadi .env.local lalu sesuaikan.

# PostgreSQL — server asli
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/accounting_next

# Kunci JWT untuk sesi login. WAJIB diganti di produksi (min. 32 karakter acak).
AUTH_SECRET=dev-secret-change-me-in-production-0123456789abcdef
